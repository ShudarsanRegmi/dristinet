[Unit]
Description=Speedtest Network Monitor - Web Dashboard
After=speedtest-collector@%i.service
Wants=speedtest-collector@%i.service
Documentation=https://github.com/your-repo/speedtest-monitor

[Service]
Type=simple
User=%i
Group=%i
WorkingDirectory=/opt/speedtest-monitor
ExecStart=/usr/bin/node backend/server.js
Restart=always
RestartSec=10
RestartPreventExitStatus=0

# Environment
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=LOG_LEVEL=info

# Security settings
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/speedtest-monitor/data
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

# Resource limits
MemoryMax=512M
CPUQuota=75%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=speedtest-dashboard

[Install]
WantedBy=multi-user.target
